@model Evento

@{
    ViewData["Title"] ="Novo Evento";
}

<h1>Criar Novo Evento</h1>

<div asp-validation-summary="All" class="erro"></div>

<form asp-action="Criar" method="post">
    <p>
    <label asp-for="Nome"></label>
    <input asp-for="Nome" />
    <span asp-validation-for="Nome" class="erro"></span>
    </p>

    <p>
    <label asp-for="Descricao"></label>
    <input asp-for="Descricao" />
    <span asp-validation-for="Descricao" class="erro"></span>
    </p>

    <p>
    <label asp-for="Local"></label>
    <input asp-for="Local" />
    <span asp-validation-for="Local" class="erro"></span>
    </p>
    <p>

    <label asp-for="DataEvento"></label>
    <input asp-for="DataEvento" />
    <span asp-validation-for="DataEvento" class="erro"></span>
    </p>
    
    <label asp-for="QuantidadeVagas"></label>
    <input asp-for="QuantidadeVagas" />
    <span asp-validation-for="QuantidadeVagas" class="erro"></span>
    </p>

    <label asp-for="ValorIngresso"></label>
    <input asp-for="ValorIngresso" />
    <span asp-validation-for="ValorIngresso" class="erro"></span>
    </p>

    <button type="Submit">Salvar</button>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}